# Generate each value with: ha-limited-access-dashboard hash-password
LANDSCAPER_PASSWORD_HASH=
CHILD_PASSWORD_HASH=
RENTAL_PASSWORD_HASH=

# Defaults to loopback:8787. Use a private LAN address only for a trusted-LAN
# deployment; use loopback behind an HTTPS reverse proxy for internet access.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8787

# Generate long, random IDs and use the same values in Home Assistant secrets.yaml.
SPRINKLER_WEBHOOK_ID=
GUEST_HOME_WEBHOOK_ID=

